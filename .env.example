# ==============================================================================
# Tripwire Environment Variables
# ==============================================================================

# --- HiDevs LLM Gateway (100k Gemini Credits for Hackathon Arena) ---
# Gateway URL: https://llm.hidevs.xyz (OpenAI compatible endpoint)
# Copy your virtual key starting with sk-... from the arena dashboard:
# https://app.hidevs.xyz/hackathons/yc-fall-2026-moss-zero-latency-builder-sprint/arena
HIDEVS_API_KEY=sk-your_hidevs_virtual_key_here
HIDEVS_BASE_URL=https://llm.hidevs.xyz/v1

# Models supported by HiDevs: gemini-3.5-flash-lite, gemini-3.5-flash, gemini-3.6-flash
GEMINI_GENERATION_MODEL=gemini-3.6-flash
GEMINI_VERDICT_MODEL=gemini-3.5-flash-lite
GEMINI_EXPLANATION_MODEL=gemini-3.5-flash-lite

# --- Fallback Google Gemini Direct API Keys (Optional, https://aistudio.google.com/) ---
GEMINI_API_KEY_1=your_primary_gemini_api_key
GEMINI_API_KEY_2=your_secondary_gemini_api_key

# --- Moss API Configuration (https://moss.dev/) ---
# Sub-10ms semantic retrieval engine for inline sentence verification
MOSS_PROJECT_ID=your_moss_project_id_here
MOSS_PROJECT_KEY=your_moss_project_key_here

# --- Embeddings for the A/B baseline (FR-12) ---
# Only needed for the brute-force cosine-similarity baseline path, not for Moss itself.
EMBEDDING_API_KEY=your_embedding_gemini_api_key

# --- LiveKit Voice Integration (FR-13) ---
# Get these from your LiveKit Cloud Dashboard (https://cloud.livekit.io/)
LIVEKIT_URL=wss://your-project-subdomain.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# --- Speech-to-Text Providers (Optional) ---
# Deepgram Nova-2 sub-100ms transcription (https://console.deepgram.com/)
# If omitted, Gemini Multimodal Audio is used automatically.
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# --- Upstash Redis (Serverless Session State) ---
# Get these from Upstash Console (https://console.upstash.com/)
UPSTASH_REDIS_REST_URL=https://your-database-id.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here